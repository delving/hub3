  "schema:url": "{{CONTEXT_BASE}}/edm/changelog.jsonld",
  "schema:itemListElement": [
    {
      "@type": "context",
      "schema:identifier": "edm-1.0",
      "version": "1.0.0",
      "released": "2025-02-20",
      "modified": "2025-02-20",
      "status": "http://schema.org/Published",
