package components

// RapiDoc is a component for rendering API documentation using RapiDoc
// It embeds the necessary script tag and allows injecting a Swagger/OpenAPI spec URL
templ RapiDoc(specURL string) {
	<div class="rapidoc-container">
		<script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>
		<rapi-doc
			spec-url={ specURL }
			render-style="read"
			theme="light"
			show-header="true"
			allow-authentication="true"
			allow-spec-url-load="false"
			allow-spec-file-load="false"
		></rapi-doc>
	</div>
}
