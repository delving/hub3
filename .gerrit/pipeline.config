# .gerrit/pipeline.config

[pipeline "test-golang"]
  description = "Test pipeline for Golang applications with security scanning"
  run = "parallel"

[job "golint"]
  command = """
    golangci-lint run ./... \
      --timeout=5m \
      --config=.golangci.yml
  """
  required = true
  timeout = "10m"

[job "gosec"]
  command = """
    gosec -quiet \
      -fmt=json \
      -out=security-report.json \
      -exclude-dir=vendor \
      -exclude-dir=testdata \
      ./...
  """
  required = true
  timeout = "10m"

[job "test"]
  command = """
    go test -v ./... \
      -race \
      -coverprofile=coverage.out \
      -covermode=atomic
  """
  required = true
  timeout = "15m"

[job "build"]
  command = """
    go build -v ./...
  """
  required = true
  timeout = "10m"

[job "integration-test"]
  command = """
    # Assuming you have integration tests in a separate directory
    go test -v ./integration/... \
      -tags=integration
  """
  required = false  # Optional job
  timeout = "20m"

[reporter "coverage"]
  command = """
    go tool cover -func=coverage.out
  """
  report-on = "test"

[reporter "security"]
  command = """
    if [ -f security-report.json ]; then
      # Print findings in a human-readable format
      echo "Security Scan Results:"
      jq -r '.Issues[] | "[\(.severity)] \(.rule_id): \(.details)"' security-report.json
    fi
  """
  report-on = "gosec"

  [trigger "patchset-created"]
  # Run pipeline on new or updated patchsets
  event = patchset-created
  pipeline = test-golang

[trigger "comment-added"]
  # Run pipeline when someone comments "run-tests"
  event = comment-added
  comment = run-tests
  pipeline = test-golang
